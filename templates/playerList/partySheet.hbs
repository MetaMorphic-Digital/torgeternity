<div class="flexrow scrollable">
  {{#each users as |user key|}}
    <div>
      <h2>{{user.name}}</h2>
      {{#if user.character }}
        <h3 class="actorName" data-action="clickActor" data-actorID="{{user.character._id}}">
          <a>{{user.character.name}}</a>
        </h3>
        <div class="flexrow">
          <div>
            <p>{{localize "torgeternity.sheetLabels.wounds"}}</p>
            <p>{{user.character.system.wounds.value}} / {{user.character.system.wounds.max}}</p>
          </div>
          <div>
            <p>{{localize "torgeternity.sheetLabels.shock"}}</p>
            <p>{{user.character.system.shock.value}} / {{user.character.system.shock.max}}</p>
          </div>
          <div>
            <p>{{localize "torgeternity.sheetLabels.possibilities"}}</p>
            <p>{{user.character.system.other.possibilities.value}}</p>
          </div>
        </div>
        <div class="flexrow">
          <div>
            <h4>{{localize "torgeternity.sheetLabels.attributes"}}</h4>
            <ul>
              {{#each user.character.system.attributes as |attr key|}}
                <li class="attribut-block">{{localizedAttribute}}: {{attr.value}}</li>
              {{/each}}
            </ul>
          </div>
          <div>
            <h4>{{localize "torgeternity.sheetLabels.defenses"}}</h4>
            <p>{{localize "torgeternity.skills.dodge"}}: {{user.character.system.defenses.dodge.value}}</p>
            <p>{{localize "torgeternity.skills.meleeWeapons"}}: {{user.character.system.defenses.meleeWeapons.value}}
            </p>
            <p>{{localize "torgeternity.skills.unarmedCombat"}}: {{user.character.system.defenses.unarmedCombat.value}}
            </p>
            <p>{{localize "torgeternity.skills.intimidation"}}: {{user.character.system.defenses.intimidation.value}}
            </p>
            <p>{{localize "torgeternity.skills.maneuver"}}: {{user.character.system.defenses.maneuver.value}}</p>
            <p>{{localize "torgeternity.skills.taunt"}}: {{user.character.system.defenses.taunt.value}}</p>
            <p>{{localize "torgeternity.skills.trick"}}: {{user.character.system.defenses.trick.value}}</p>
          </div>
        </div>
        <div class="flexrow">
          {{#if user.character.system.statusModifiers.vulnerable}}
            <p>{{localize "torgeternity.vulnerableStates.vulnerable"}}:
              {{user.character.system.statusModifiers.vulnerable}}
            </p>
          {{/if}} {{#if user.character.system.statusModifiers.stymied}}
            <p>{{localize "torgeternity.stymiedStates.stymied"}}: {{user.character.system.statusModifiers.stymied}}</p>
          {{/if}}
          {{#if user.character.system.statusModifiers.concentrating}}
            <p>{{localize "torgeternity.statusEffects.concentrating"}}:
              {{user.character.system.statusModifiers.concentrating}}
            </p>
          {{/if}}
        </div>
        <div class="flexrow">
          <div>
            <h4>{{localize "torgeternity.sheetLabels.skills"}}</h4>
            <ul>
              {{#each user.character.system.skills as |skill key|}}
                {{#if skill.adds}}
                  <li class="attribut-block">
                    {{skill.localizedSkill}}: {{skill.value}}
                    {{#if skill.isFav}}<i class="far fa-star"></i>{{/if}}
                  </li>
                {{/if}}
              {{/each}}
            </ul>
          </div>
          <div>
            <h4>{{localize "DOCUMENT.Items"}}</h4>
            <ul>
              {{#each user.character.items as |item key|}}
                <li>
                  <span>
                    <a
                      class="item-link" data-action="clickItem"
                      data-actorID="{{../this.character._id}}"
                      data-itemID="{{item._id}}">
                      {{item.name}}
                    </a>
                    -
                    <em>{{localize (lookup @root.CONFIG.Item.typeLabels item.type)}}</em>
                  </span>
                </li>
              {{/each}}
            </ul>
          </div>
        </div>
      {{else}}
        {{localize 'torgeternity.partySheet.noCharacter'}}
      {{/if}}
    </div>
  {{/each}}
</div>