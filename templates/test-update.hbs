    <div> {{> "systems/torgeternity/templates/testDialogs/multi-action-selector.hbs"}} </div>
    <div> {{> "systems/torgeternity/templates/testDialogs/multi-target-selector.hbs"}} </div>
  </div>
  <div> {{> "systems/torgeternity/templates/testDialogs/modifiers-table.hbs"}} </div>
