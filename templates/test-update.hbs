    {{> "systems/torgeternity/templates/testDialogs/actor-options.hbs"}}
  </div>
  <div class="flexrow">
    <div> {{> "systems/torgeternity/templates/testDialogs/difficulty-selector.hbs"}} </div>
    <div> {{> "systems/torgeternity/templates/testDialogs/movement-penalty-selector.hbs"}} </div>
