<div>
  <footer class="form-footer">
    {{#each buttons as |button|}}
      <button type="{{button.type}}" {{#if button.name}}name="{{button.name}}" {{/if}} class="{{button.cssClass}}"
        {{#if button.tooltip}}data-tooltip="{{localize button.tooltip}}" {{/if}}
        {{#if button.action}}data-action="{{button.action}}" {{/if}} {{#if button.disabled}}disabled{{/if}}>
        {{#if button.icon}}<i class="{{button.icon}}" inert></i>{{/if}}
        {{#if button.label}}<span>{{localize button.label}}</span>{{/if}}
      </button>
    {{/each}}
  </footer>
  <div id="handedCards">
    <ol class="cards destinyCards" data-cards>
      {{#each cards as |card|}}
        {{#if (eq card.type "destiny")}}
          <li class="card flexrow {{#if card.system.pooled}}pooled{{/if}}"
            data-card-id="{{card.id}}">
            <img class="card-face" src="{{card.img}}" data-action="focusCard" alt="{{card.name}}" height="48">

            <div class="torg-card-controls controls flexcol">
              <div class="card-faces flexrow">
                <a class="card-control" data-tooltip="{{localize 'CARDS.ACTIONS.NextFace'}}" data-action="controlCard"
                  data-control="nextFace"
                  {{disabled (not card.hasNextFace)}}><i class="fas fa-caret-up"></i>
                </a>
                <a class="card-control" data-tooltip="{{localize 'CARDS.ACTIONS.PreviousFace'}}"
                  data-action="controlCard"
                  data-control="prevFace"
                  {{disabled (not card.hasPreviousFace)}}><i class="fas fa-caret-down"></i>
                </a>
              </div>
              <a class="card-control" data-tooltip="{{localize 'torgeternity.dialogPrompts.playCard'}}"
                data-action="controlCard" data-control="play" {{disabled @root.disablePlay}}>
                <i class="fas fa-play-circle" style="color:white"></i>
              </a>
              <!-- <a class="card-control" data-tooltip="View Card" data-action="controlCard" data-control="view"><i class="fas fa-eye" style="color:white"></i></a> not needed with thumbnail? -->
              <a class="card-control" data-tooltip="{{localize 'torgeternity.dialogPrompts.showToPlayers'}}"
                data-action="controlCard" data-control="display">
                <i class="fas fa-broadcast-tower" style="color:white"></i>
              </a>
              <a class="card-control" data-tooltip="{{localize 'torgeternity.dialogPrompts.playerPassTo'}}"
                data-action="controlCard" data-control="pass">
                <i class="fas fa-share-square" style="color:white"></i>
              </a>
              <a class="card-control" data-tooltip="{{localize 'torgeternity.dialogPrompts.discardCard'}}"
                data-action="controlCard" data-control="discard">
                <i class="fas fa-inbox" style="color:white"></i>
              </a>
              <span class="card-pooled">
                <h5 class="verticalRot">
                  {{localize "torgeternity.dialogPrompts.cardPooled"}}
                </h5>
                <input name="data.system.pooled" class="toggle" data-action="poolToggle"
                  type="checkbox" id="pooled" {{checked card.system.pooled}}>
              </span>
            </div>
          </li>
        {{/if}}
      {{/each}}


    </ol>

    <ol class="cards cosmCards" data-cards>
      {{#each cards as |card|}}
        {{#if (eq card.type "cosm")}}

          <li class="card flexrow" data-card-id="{{card.id}}">
            <img class="card-face" src="{{card.img}}" data-action="focusCard" alt="{{card.name}}" height="48">
            <div class="torg-card-controls controls flexcol">
              <div class="card-faces flexrow">
                <a class="card-control" data-tooltip="{{localize 'CARDS.ACTIONS.NextFace'}}" data-action="controlCard"
                  data-control="nextFace"
                  {{disabled (not card.hasNextFace)}}><i class="fas fa-caret-up"></i>
                </a>
                <a class="card-control" data-tooltip="{{localize 'CARDS.ACTIONS.PreviousFace'}}"
                  data-action="controlCard"
                  data-control="prevFace"
                  {{disabled (not card.hasPreviousFace)}}><i class="fas fa-caret-down"></i>
                </a>
              </div>
              <a class="card-control" data-tooltip="{{localize 'torgeternity.dialogPrompts.playCard'}}"
                data-action="controlCard" data-control="play">
                <i class="fas fa-play-circle" style="color:white"></i>
              </a>
              <!-- <a class="card-control" data-tooltip="View Card" data-action="view"><i class="fas fa-eye" style="color:white"></i></a> not needed with thumbnail? -->
              <a class="card-control" data-tooltip="{{localize 'torgeternity.dialogPrompts.showToPlayers'}}"
                data-action="controlCard" data-control="display">
                <i class="fas fa-broadcast-tower" style="color:white"></i>
              </a>
              <a class="card-control" data-tooltip="{{localize 'torgeternity.dialogPrompts.playerPassTo'}}"
                data-action="controlCard" data-control="pass">
                <i class="fas fa-share-square" style="color:white"></i>
              </a>
              <a class="card-control" data-tooltip="{{localize 'torgeternity.dialogPrompts.discardCard'}}"
                data-action="controlCard" data-control="discard">
                <i class="fas fa-inbox" style="color:white"></i>
              </a>
            </div>
          </li>
        {{/if}}
      {{/each}}
    </ol>
  </div>
</div>